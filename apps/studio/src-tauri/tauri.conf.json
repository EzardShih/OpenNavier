{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenNavier Studio",
  "version": "0.1.0",
  "identifier": "dev.opennavier.studio",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run web:build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenNavier Studio",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  }
}
